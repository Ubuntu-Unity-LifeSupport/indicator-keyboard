#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export DPKG_GENSYMBOLS_CHECK_LEVEL=4

%:
	dh $@

override_dh_autoreconf:
	NOCONFIGURE=1 dh_autoreconf ./autogen.sh

execute_after_dh_install:
	find debian/indicator-keyboard/usr/lib -name *.la -delete
	find debian/indicator-keyboard/usr/lib -name *.a -delete

# Temporarily ignore build test failures
# https://launchpad.net/bugs/1968333
override_dh_auto_test:
	XDG_CURRENT_DESKTOP=Unity:Unity7:ubuntu dh_auto_test || true
